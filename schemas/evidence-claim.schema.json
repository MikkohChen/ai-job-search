{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:car:evidence-claim:1.0.0","type":"object","additionalProperties":false,"required":["schema_version","claim_id","text","evidence_ids","confidence","status","source_versions"],"properties":{"schema_version":{"const":"1.0.0"},"claim_id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"confidence":{"type":"integer","minimum":0,"maximum":100},"status":{"enum":["verified","unverified","rejected"]},"source_versions":{"type":"array","items":{"type":"string","minLength":1}}},"allOf":[{"if":{"properties":{"status":{"const":"verified"}}},"then":{"properties":{"evidence_ids":{"minItems":1},"source_versions":{"minItems":1}}}}]}
